DJANGO_SECRET_KEY=replace-with-a-generated-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=spotter_fuel
DB_USER=spotter_app
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Windows only: adapt these paths to your local PostGIS installation.
GIS_LIBRARY_DIRECTORY=C:/Program Files/PostgreSQL/16/bin
GDAL_LIBRARY_PATH=C:/Program Files/PostgreSQL/16/bin/libgdal-34.dll
GEOS_LIBRARY_PATH=C:/Program Files/PostgreSQL/16/bin/libgeos_c.dll

# Optional: only needed for live station geocoding.
ORS_API_KEY=
GEOCODING_TIMEOUT=10
GEOCODING_INTERVAL=1
GEOCODING_CACHE_DAYS=30
GEOCODING_MIN_CONFIDENCE=0.9

# Dedicated PostGIS test database; never use the development DB for tests.
DB_TEST_NAME=test_spotter_fuel

# Windows PROJ coordinate-reference database installed by PostGIS.
PROJ_DATA=C:/Program Files/PostgreSQL/16/share/contrib/postgis-3.4/proj

# Routing settings
ROUTING_TIMEOUT=15
ORS_REQUEST_INTERVAL=1.6
ROUTE_CACHE_SECONDS=86400
ROUTE_CORRIDOR_METRES=2000
STATION_MAX_SNAP_METRES=200
ROUTE_REQUEST_RATE=30/min
DB_CONN_MAX_AGE=60
